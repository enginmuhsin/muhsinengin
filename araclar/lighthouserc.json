{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/zeka-oyunlari/index.html",
        "http://localhost/zeka-oyunlari/satranc/index.html",
        "http://localhost/zeka-oyunlari/salon/index.html",
        "http://localhost/dron-lab/index.html",
        "http://localhost/pid-oyunu/index.html",
        "http://localhost/kriptoloji/index.html"
      ],
      "numberOfRuns": 1,
      "settings": { "onlyCategories": ["performance", "accessibility", "best-practices", "seo"], "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.5 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
